# ======================================================
# TaoPat configuration
# Copy this file to ".env" and edit the values you need.
# Every variable is optional. Commented lines show the default.
# Real environment variables always override values in .env.
# ======================================================

# Port the server listens on.
# PORT=3000

# Interface to bind to. Leave empty to listen on all interfaces.
# Use 127.0.0.1 to accept local connections only (recommended when the app
# is only reachable through Cloudflare Tunnel or a local reverse proxy).
# HOST=

# Public URL prefix the app is served under. Empty = site root.
# Use /TaoPat (leading slash, no trailing slash) when a proxy exposes the app
# at https://example.com/TaoPat/. The app then prefixes its own routes
# (/socket.io, /api, /healthz) and still accepts requests with the prefix
# either stripped or kept by the proxy.
# BASE_PATH=

# How the real client IP is resolved (used for rate limiting and country lookup).
#   auto        trust X-Forwarded-For only when the direct peer is loopback/private
#   off         never trust forwarding headers (always the socket address)
#   on          always trust the rightmost X-Forwarded-For entry
#   cloudflare  always use CF-Connecting-IP (only if the server is reachable
#               exclusively through Cloudflare, e.g. Cloudflare Tunnel)
# TRUST_PROXY=auto

# Comma-separated browser Origins allowed to open a socket.
# Empty = any origin allowed. Example: https://game.example.com
# ALLOWED_ORIGINS=

# ------------------------------------------------------
# Rate-limit / anti-abuse overrides (LIMIT_<KEY>)
# Each value must be a number > 0. Defaults come from lib/guard.js.
# Uncomment only the ones you want to change.
# ------------------------------------------------------
# LIMIT_MAX_BATCH=100
# LIMIT_USER_BURST=15
# LIMIT_USER_TPS=25
# LIMIT_IP_BURST=80
# LIMIT_IP_TPS=150
# LIMIT_EVENT_BURST=30
# LIMIT_EVENT_PER_SEC=15
# LIMIT_CONNECT_BURST=10
# LIMIT_CONNECT_PER_SEC=1
# LIMIT_IP_MAX_CONNECTIONS=20
# LIMIT_CLIENT_MAX_SOCKETS=4
# LIMIT_COMBO_GAP_MS=1200
# LIMIT_RATE_WINDOW_MS=1000
# LIMIT_DROP_POINTS=0.2
# LIMIT_MALFORMED_POINTS=5
# LIMIT_UNKNOWN_EVENT_POINTS=2
# LIMIT_EVENT_FLOOD_POINTS=0.5
# LIMIT_BAN_SCORE=30
# LIMIT_SCORE_DECAY_PER_SEC=0.5
# LIMIT_BAN_MS=600000
# LIMIT_MAX_TRACKED_KEYS=20000
